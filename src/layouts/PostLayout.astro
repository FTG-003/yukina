---
import Main from "../layouts/MainLayout.astro";
import Markdown from "../components/Markdown.astro";
import CopyRight from "../components/misc/CopyRight.astro";
import CritiqueBlock from "../components/misc/CritiqueBlock.astro";

interface Props {
  title?: string;
  subTitle?: string;
  bannerImage?: string;
  published?: Date;
  license?: {
    name: string;
    url?: string;
  };
  author?: string;
  sourceLink?: string;
  description?: string;
  image?: string;
}

const { title, subTitle, bannerImage, published, license, author, sourceLink } =
  Astro.props;
---

<Main
  title={title}
  subTitle={subTitle}
  bannerImage={bannerImage}
  author={author}
>
  <link
    slot="head"
    rel="stylesheet"
    href="https://fastly.jsdelivr.net/npm/katex/dist/katex.min.css"
  />
  <div class="article-wrapper">
    <div class="article">
      <Markdown>
        <slot />
      </Markdown>
      {
        published && title && (
          <CopyRight
            title={title}
            published={published}
            license={license}
            author={author}
            sourceLink={sourceLink}
          />
        )
      }
      <CritiqueBlock />
    </div>
  </div>
</Main>

<style>
  .article-wrapper {
    @apply rounded-2xl bg-[var(--card-color)] px-4 py-5;
    @apply md:px-6 md:py-6;
    @apply lg:px-10 lg:py-9;
  }
  .article {
    @apply flex flex-col text-base leading-relaxed;
    color: var(--text-color);
  }

  /* ── Contenitore scrollabile per overflow ── */
  .article :global(pre),
  .article :global(table),
  .article :global(.katex-display) {
    @apply max-w-full overflow-x-auto;
  }

  /* ── Immagini reattive ── */
  .article :global(img) {
    @apply h-auto max-w-full;
  }

  /* ── Codice inline ── */
  .article :global(code) {
    @apply break-words text-sm;
  }
</style>

<style is:global>
  /* Forza tipografia leggibile nel post, light e dark */
  .article .prose {
    max-width: 100% !important;
  }
  .article .prose p {
    color: var(--text-color) !important;
  }
</style>
