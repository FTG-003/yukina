---
import YukinaConfig from "../../yukina.config";
import BaseHead from "../components/BaseHead.astro";
import ScriptSetup from "../components/ScriptSetup.astro";

const { title, description, image } = Astro.props;
---

<html lang={YukinaConfig.locale} data-theme="light">
  <head>
    <BaseHead title={title} description={description} image={image} />
    <slot name="head" />
  </head>
  <body
    class="overflow-x-hidden overflow-y-hidden bg-[var(--background-color)] text-[var(--text-color)]"
  >
    <slot />
    <ScriptSetup />

    <script is:inline>
      (function() {
        var theme = localStorage.getItem('yukina-theme');
        if (!theme) {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', theme);
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
  </body>
</html>
